# Directory of reference images the MCP server may list, return, and analyze.
REFERENCE_IMAGE_DIR=/absolute/path/to/reference-images

# Directory of persistent processor checkpoints. Populate it once with:
#   uv run python -m controlnet_mcp.prepare_models
MODEL_DIR=/absolute/path/to/controlnet-models

# Directory where generated analysis images are cached.
OUTPUT_DIR=/absolute/path/to/controlnet-analysis

# Hugging Face cache used while preparing models (optional).
HF_HOME=/absolute/path/to/huggingface-cache

# Keep false so the running server exports HF_HUB_OFFLINE=1 and can never download.
ALLOW_MODEL_DOWNLOADS=false

# Detection resolution used when a tool call does not supply one (64 to 2048).
DEFAULT_DETECT_RESOLUTION=512

# Number of learned processors kept resident in memory at once.
MAX_LOADED_MODELS=1

# auto, cpu, cuda, or mps
DEVICE=auto

# How much of each analysis's measurements the result text carries: off, brief, or full.
RESULT_MEASUREMENTS=brief
